{
  "name": "rugix-admin-frontend",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "generate:sidex": "cd ../crates/apps/rugix-admin && sidex generate ts ../../../frontend/src/generated",
    "predev": "pnpm run generate:sidex",
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm run generate:sidex && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "cd tests && uv run pytest",
    "test:e2e:headed": "cd tests && uv run pytest --headed --slowmo 250 -s",
    "test:e2e:browsers": "nix build --no-warn-dirty --out-link tests/.cache/playwright-browsers github:NixOS/nixpkgs/07e1d92cdc0ed416cfa11ff3ca40d17e61cfba7a#playwright-driver.browsers",
    "test:e2e:nix": "pnpm run test:e2e:browsers && cd tests && RUGIX_ADMIN_TESTS_PLAYWRIGHT_BROWSERS=\"$PWD/.cache/playwright-browsers\" uv run pytest",
    "test:e2e:headed:nix": "pnpm run test:e2e:browsers && cd tests && RUGIX_ADMIN_TESTS_PLAYWRIGHT_BROWSERS=\"$PWD/.cache/playwright-browsers\" uv run pytest --headed --slowmo 250 -s"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@sidex/types": "^0.0.8",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  }
}
