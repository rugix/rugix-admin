//! HTTP API contract for Rugix Admin.

import apps::AppState
import apps::AppStatus
import jobs::Job

#[rust(type = "::serde_json::Value")]
opaque JsonValue

/// Health response.
record HealthResponse {
    /// Service readiness status.
    status: HealthStatus,
}

/// Rugix Admin readiness status.
#[json(tagged = externally, rename_all = "lowercase")]
variant HealthStatus {
    /// The service is ready to accept requests.
    Ok,
}

/// Effective privileged daemon policy used by Rugix Admin.
record DaemonInfoResponse {
    /// Whether the daemon permits bypassing verification and compatibility checks.
    dangerously_insecure: bool,
    /// Additional privileged operation families exposed by the daemon.
    features: DaemonFeatures,
}

/// Effective state of the daemon's optional privileged operation families.
record DaemonFeatures {
    /// Whether factory resets are enabled.
    factory_reset: bool,
    /// Whether committing the active system is enabled.
    system_commit: bool,
    /// Whether explicit system reboots are enabled.
    system_reboot: bool,
    /// Whether application lifecycle management is enabled.
    app_lifecycle: bool,
}

/// Error response body.
record ApiErrorResponse {
    /// Error details.
    error: ApiError,
}

/// API error details.
record ApiError {
    /// Machine-readable error code.
    code: string,
    /// Human-readable error message.
    message: string,
    /// Command output available when Rugix Ctrl exits unsuccessfully.
    details?: CommandFailureDetails,
}

/// Details captured from an unsuccessful Rugix Ctrl command.
record CommandFailureDetails {
    /// Process exit status.
    exit_status: string,
    /// Standard output, when non-empty.
    stdout?: string,
    /// Standard error, when non-empty.
    stderr?: string,
}

/// System action accepted by the Rugix Admin API.
#[json(tagged = externally, rename_all = "kebab-case")]
variant SystemAction {
    /// Reset persistent state and reboot.
    FactoryReset,
    /// Make the active system the default.
    Commit,
    /// Reboot the active system.
    Reboot,
    /// Reboot into the spare system.
    RebootSpare,
}

/// Application action accepted by the Rugix Admin API.
#[json(tagged = externally, rename_all = "kebab-case")]
variant AppAction {
    /// Start the active workload.
    Start,
    /// Stop the active workload.
    Stop,
    /// Activate an application generation.
    Activate,
    /// Deactivate the active generation.
    Deactivate,
    /// Roll back to the previously active generation.
    Rollback,
    /// Remove the application.
    Remove,
    /// Remove unused application generations.
    Gc,
}

/// Reboot behavior for a system update.
#[json(tagged = externally, rename_all = "lowercase")]
variant SystemRebootMode {
    /// Select the installed system and reboot immediately.
    Yes,
    /// Do not change boot selection.
    No,
    /// Select the installed system without rebooting.
    Set,
    /// Record the installed system for selection during the next boot.
    Deferred,
}

/// Query parameters accepted when installing a system update.
record SystemInstallOptions {
    /// Expected bundle hash override.
    bundle_hash?: string,
    /// Root certificate path override.
    root_cert?: string,
    /// Whether to permit an unsigned bundle.
    insecure_skip_bundle_verification?: bool,
    /// Whether to permit payloads without a block index.
    insecure_allow_missing_block_index?: bool,
    /// Whether to bypass component compatibility checks.
    skip_compatibility_check?: bool,
    /// Reboot behavior after installation.
    reboot?: SystemRebootMode,
    /// Boot group to update.
    boot_group?: string,
    /// Whether to preserve the target slot's overlay.
    keep_overlay?: bool,
    /// Whether HTTP range requests should be disabled.
    disable_range_queries?: bool,
    /// Maximum number of retries for transient HTTP errors.
    http_max_retries?: u32,
    /// Initial HTTP retry backoff in seconds.
    http_retry_initial_backoff?: u64,
    /// Maximum HTTP retry backoff in seconds.
    http_retry_max_backoff?: u64,
}

/// Query parameters accepted when installing an application bundle.
record AppInstallOptions {
    /// Expected bundle hash override.
    bundle_hash?: string,
    /// Root certificate path override.
    root_cert?: string,
    /// Whether to permit an unsigned bundle.
    insecure_skip_bundle_verification?: bool,
    /// Whether to permit payloads without a block index.
    insecure_allow_missing_block_index?: bool,
    /// Whether to bypass component compatibility checks.
    skip_compatibility_check?: bool,
    /// Maximum number of retries for transient HTTP errors.
    http_max_retries?: u32,
    /// Initial HTTP retry backoff in seconds.
    http_retry_initial_backoff?: u64,
    /// Maximum HTTP retry backoff in seconds.
    http_retry_max_backoff?: u64,
}

/// Query parameters accepted by application lifecycle actions.
record AppActionOptions {
    /// Generation to activate.
    generation?: u64,
    /// Number of previously active generations to retain during garbage collection.
    keep?: idx,
    /// Whether to bypass component compatibility checks.
    skip_compatibility_check?: bool,
}

/// Query parameters accepted when garbage collecting all applications.
record AppGarbageCollectionOptions {
    /// Number of previously active generations to retain for each application.
    keep?: idx,
}

/// Query parameters accepted by system actions.
record SystemActionOptions {
    /// Whether a factory reset should preserve the old state as a profile.
    backup?: bool,
    /// Optional name for the preserved state profile.
    backup_name?: string,
}

/// Request to install a bundle from an HTTP source.
record InstallFromUrlRequest {
    /// HTTP or HTTPS bundle URL.
    url: string,
}

/// System information reported by `rugix-ctrl`.
record SystemInfoResponse {
    /// Information about the slots.
    slots: [string: SystemSlotInfo],
    /// Information about the boot flow, if system updates are configured.
    boot?: SystemBootInfo,
    /// Information about the state-management mechanism.
    state: SystemStateInfo,
}

/// Information about a system slot.
record SystemSlotInfo {
    /// Whether the slot is currently active.
    active?: bool,
    /// Stored hashes of the slot payload.
    hashes?: [string: string],
    /// Stored size of the slot payload in bytes.
    size?: u64,
    /// Time at which the slot was last updated.
    updated_at?: string,
}

/// Information about the configured boot flow.
record SystemBootInfo {
    /// Name of the boot flow.
    boot_flow: string,
    /// Active boot group, if known.
    active_group?: string,
    /// Default boot group, if known.
    default_group?: string,
    /// Configured boot groups.
    groups: [string: SystemBootGroupInfo],
}

/// Information about a boot group.
record SystemBootGroupInfo {}

/// Information about the state-management mechanism.
#[json(tag = "status")]
variant SystemStateInfo {
    /// State management is disabled.
    Disabled,
    /// State management is active.
    Active: SystemStateActiveInfo,
    /// State management is inactive due to an error.
    Error: SystemStateErrorInfo,
}

/// Information available while state management is active.
record SystemStateActiveInfo {
    /// Device backing the data partition, if any.
    data_partition?: string,
}

/// Information about a state-management error.
record SystemStateErrorInfo {
    /// Human-readable description of the error.
    message?: string,
    /// Whether state is temporarily stored in memory and may not persist.
    ephemeral?: bool,
}

/// Output of the component consistency check.
record ComponentsCheckResponse {
    /// Component roots that were scanned.
    roots: [ComponentRoot],
    /// Components loaded from the scanned roots.
    components: [LoadedComponent],
    /// Whether the loaded component set is internally consistent.
    consistent: bool,
    /// Problems found while checking the component set.
    problems: [ComponentProblem],
}

/// Root directory scanned for component metadata.
record ComponentRoot {
    /// Kind of component source.
    kind: ComponentSourceKind,
    /// Root path.
    path: string,
    /// App name for app-owned roots.
    app?: string,
    /// Active app generation for app-owned roots.
    generation?: u64,
}

/// Component loaded from a source.
record LoadedComponent {
    /// Source from which the component was loaded.
    source: ComponentSource,
    /// Loaded component declaration.
    component: Component,
}

/// Source for a component declaration.
record ComponentSource {
    /// Kind of component source.
    kind: ComponentSourceKind,
    /// Source path or identifier.
    path: string,
    /// App name for app-owned sources.
    app?: string,
    /// Active app generation for app-owned sources.
    generation?: u64,
}

/// Kind of component source.
#[json(tagged = externally)]
variant ComponentSourceKind {
    /// Components installed as part of the system image.
    System,
    /// Persistent local or admin-provided components.
    Local,
    /// Runtime-generated components.
    Runtime,
    /// Component metadata owned by an active app generation.
    App,
    /// Component metadata declared by a bundle.
    Bundle,
    /// Component metadata synthesized by Rugix Ctrl.
    Synthetic,
}

/// Component declaration.
record Component {
    /// Component ID.
    id: string,
    /// Component version, if any.
    version?: string,
    /// Explicit capabilities provided by the component.
    provides: [Capability],
    /// Exclusive resource claims declared by the component.
    claims?: [Claim],
    /// Requirement selectors declared by the component.
    requires: [CapabilitySelector],
    /// Conflict selectors declared by the component.
    conflicts: [CapabilitySelector],
}

/// Exclusive resource claim.
record Claim {
    /// Claim ID.
    id: string,
}

/// Provided capability.
record Capability {
    /// Capability ID.
    id: string,
    /// Capability version, if any.
    version?: string,
    /// Capability value, if any.
    value?: string,
}

/// Capability selector used by requirements and conflicts.
record CapabilitySelector {
    /// Capability ID selected by the selector.
    id: string,
    /// Version requirement, if any.
    version?: string,
    /// Value matched by the selector, if any.
    value?: string,
}

/// Internal consistency problem in the component set.
#[json(tag = "kind")]
variant ComponentProblem {
    /// More than one component uses the same component ID.
    DuplicateComponent: DuplicateComponentProblem,
    /// More than one component claims the same exclusive resource.
    DuplicateClaim: DuplicateClaimProblem,
    /// A requirement selector was not satisfied.
    UnsatisfiedRequirement: UnsatisfiedRequirementProblem,
    /// A conflict selector matched a provided capability.
    Conflict: ComponentConflictProblem,
}

/// Duplicate component ID problem.
record DuplicateComponentProblem {
    /// Duplicate component ID.
    id: string,
    /// Sources declaring the duplicate component ID.
    sources: [ComponentSource],
}

/// Duplicate exclusive resource claim problem.
record DuplicateClaimProblem {
    /// Duplicate claim ID.
    id: string,
    /// Components declaring the duplicate claim.
    components: [ComponentRef],
}

/// Reference to a component and its source, if known.
record ComponentRef {
    /// Component ID.
    id: string,
    /// Source of the component, if known.
    source?: ComponentSource,
}

/// Unsatisfied requirement problem.
record UnsatisfiedRequirementProblem {
    /// Component declaring the requirement selector.
    component: ComponentRef,
    /// Requirement selector that was not satisfied.
    selector: CapabilitySelector,
}

/// Conflict problem.
record ComponentConflictProblem {
    /// Component declaring the conflict selector.
    component: ComponentRef,
    /// Conflict selector that matched.
    selector: CapabilitySelector,
    /// Component providing the conflicting capability.
    provider: ComponentRef,
    /// Capability matched by the conflict selector.
    capability: Capability,
}

/// List of installed apps.
record AppsListResponse {
    /// Apps sorted by name.
    apps: [AppSummary],
}

/// App summary.
record AppSummary {
    /// App name.
    name: string,
    /// Live workload status.
    status: AppStatus,
    /// Current generation, if any.
    generation?: u64,
    /// User-supplied metadata for the current generation.
    metadata?: JsonValue,
}

/// Detailed app information.
record AppInfoResponse {
    /// App name.
    name: string,
    /// Live workload status.
    status: AppStatus,
    /// Persisted app state.
    state: AppState,
    /// Installed generations.
    generations: [AppGeneration],
}

/// Generation information.
record AppGeneration {
    /// Generation number.
    number: u64,
    /// Creation timestamp.
    created_at: string,
    /// Whether the generation is complete.
    complete: bool,
    /// Whether the generation is currently active.
    active: bool,
    /// Timestamp of the last successful activation, if any.
    last_activated?: string,
    /// User-supplied generation metadata.
    metadata?: JsonValue,
}

/// Job response.
record JobResponse {
    /// Job snapshot.
    job: Job,
}

/// Job list response.
record JobsListResponse {
    /// Jobs, newest first.
    jobs: [Job],
}
