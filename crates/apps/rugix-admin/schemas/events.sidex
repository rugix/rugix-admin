//! Server-sent event contracts for Rugix Admin.

import jobs::Job

/// Events emitted across the Rugix Admin service.
#[json(tag = "type", rename_all = "kebab-case")]
variant ServerEvent {
    /// Cached device information may have changed.
    InvalidateAll,
}

/// Events emitted for a Rugix Admin job.
#[json(tag = "type", rename_all = "kebab-case")]
variant AdminEvent {
    /// The tracked job changed.
    JobChanged: JobChangedEvent,
    /// The job produced process output.
    JobOutput: JobOutputEvent,
    /// The upload phase changed.
    UploadProgress: UploadProgressEvent,
    /// The installation phase changed.
    InstallProgress: InstallProgressEvent,
    /// Rugix Ctrl bypassed a compatibility check.
    CompatibilityCheckSkipped: CompatibilityCheckSkippedEvent,
    /// An explicit application activation completed.
    AppActivationResult: AppActivationResultEvent,
}

/// Output stream produced by Rugix Ctrl.
#[json(tagged = externally, rename_all = "lowercase")]
variant JobOutputStream {
    /// Standard output.
    Stdout,
    /// Standard error.
    Stderr,
}

/// Event emitted when a job changes.
record JobChangedEvent {
    /// Updated job snapshot.
    job: Job,
}

/// Event emitted when a job emits output.
record JobOutputEvent {
    /// Stable job id.
    job_id: string,
    /// Output stream.
    stream: JobOutputStream,
    /// One output line.
    line: string,
}

/// Event emitted while upload bytes are streamed to Rugix Ctrl.
record UploadProgressEvent {
    /// Stable job id.
    job_id: string,
    /// Number of uploaded bytes written to the child process.
    bytes: u64,
}

/// Event emitted while a system update is being installed.
record InstallProgressEvent {
    /// Stable job id.
    job_id: string,
    /// Installation progress percentage.
    progress: f64,
}

/// Event emitted when Rugix Ctrl bypasses a component compatibility check.
record CompatibilityCheckSkippedEvent {
    /// Stable job id.
    job_id: string,
    /// Scope of the bypassed check.
    scope: CompatibilityCheckScope,
    /// Human-readable reason for bypassing the check.
    reason: string,
}

/// Bundle target whose compatibility check was bypassed.
#[json(tagged = externally, rename_all = "lowercase")]
variant CompatibilityCheckScope {
    /// System bundle installation.
    System,
    /// Application bundle installation.
    App,
}

/// Outcome of an explicit application activation.
#[json(tagged = externally, rename_all = "kebab-case")]
variant AppActivationOutcome {
    /// The requested generation was activated.
    Activated,
    /// Activation failed and Rugix rolled back successfully.
    RolledBack,
    /// Activation failed without attempting a rollback.
    Failed,
    /// Activation and the automatic rollback both failed.
    RollbackFailed,
}

/// Event emitted after an explicit application activation attempt.
record AppActivationResultEvent {
    /// Stable job id.
    job_id: string,
    /// Application name.
    app: string,
    /// Requested generation.
    generation: u64,
    /// Activation outcome.
    outcome: AppActivationOutcome,
}
